timestamp=2026-11-15T05:57:18.292Z level=INFO run=10af92a7 message=evaluated permission=bash pattern="cat > b.py <<'EOF'\nexec(open('a.py').read().split('for a in')[0])\nimport numpy as np\nu=np.array([0.05326,0.007097,0.998555]);v=np.array([-0.527553,0.849235,0.022102]);n=np.array([-0.847851,-0.527968,0.048974])\nO=np.array([-105.5,41,97.5])\ndef uvn(p): d=np.array(p)-O; return [round(float(d@u),2),round(float(d@v),2),round(float(d@n),2)]\nfor a in [50,70,90]:\n    c=rot(lid,a).intersect(enc)\n    for s in c.Solids():\n        vs=[uvn(x.toTuple()) for x in s.Vertices()]\n        arr=np.array(vs); print(a,'enc/world frame uvn min',arr.min(0),'max',arr.max(0))\n        # lid frame\n        s2=s.rotate(P,P+D,-a)\n        arr=np.array([uvn(x.toTuple()) for x in s2.Vertices()]); print('   lid frame min',arr.min(0),'max',arr.max(0))\nEOF" action.permission=* action.action=allow action.pattern=*
