timestamp=2026-11-15T05:56:49.124Z level=INFO run=10af92a7 message=evaluated permission=bash pattern="cat > a.py <<'EOF'\nimport cadquery as cq, math\nfrom cadquery import Vector as V\nlid=cq.importers.importStep('/task/parts/lid.step').val()\nenc=cq.importers.importStep('/task/parts/enclosure.step').val()\nmod=cq.importers.importStep('/task/parts/lid_module.step').val()\nP=V(-131.796,27.308,99.887); D=V(-0.847851,-0.527968,0.048974)\ndef rot(s,a): return s.rotate(P,P+D,a)\nfor a in [38,50,70,90,110]:\n    l=rot(lid,a)\n    c=l.intersect(enc)\n    print(a,c.Volume())\n    for s in c.Solids():\n        bb=s.BoundingBox(); \n        # rotate back\n        b=s.rotate(P,P+D,-a).BoundingBox()\n        print('  ',round(s.Volume(),3),'lidframe',[round(x,1) for x in (b.xmin,b.xmax,b.ymin,b.ymax,b.zmin,b.zmax)])\nEOF" action.permission=* action.action=allow action.pattern=*
